# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Neon Postgres ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Wix App (from dev.wix.com → your app) ---
WIX_APP_ID=
WIX_APP_SECRET=
WIX_WEBHOOK_PUBLIC_KEY=
WIX_TOKENS_MASTER_KEY= # 32-byte hex string (64 characters) for encrypting stored OAuth tokens

# --- Cloudflare R2 (media storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wix-reviews-media
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Email (Resend for transactional) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=reviews@vibcoders.com

# --- SMS (Twilio — optional for v1) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- LLM (for AI moderation) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Misc ---
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
