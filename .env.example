# Copy this file to .env.local for each app (and to .env for shared root tooling).
# Never commit real values.

# --- Neon Postgres ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Wix App ---
WIX_APP_ID=
WIX_APP_SECRET=
WIX_WEBHOOK_PUBLIC_KEY=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wix-apps-media
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Email ---
# Zoho ZeptoMail is used when ZEPTOMAIL_TOKEN is set (Send Mail Token, with or
# without the "Zoho-enczapikey " prefix); otherwise Resend.
ZEPTOMAIL_TOKEN=
# Copy the API host from ZeptoMail's API page, e.g. https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_URL=
EMAIL_FROM_ADDRESS=reviews@bodhamlabs.com
RESEND_API_KEY=

# --- SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- LLM (moderation) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
